# Copy to .env and adjust. Never commit the real .env.

# Postgres started by `docker compose up -d db`
DATABASE_URL=postgres://replog:replog@localhost:5432/replog
# Separate database used only by `npm test` (created automatically by docker compose)
TEST_DATABASE_URL=postgres://replog:replog@localhost:5432/replog_test

PORT=3001
# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
NODE_ENV=development
